generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PG_URI")
}

/// Основна таблиця користувачів
model User {
  id                 String     @id @default(uuid()) // Унікальний ідентифікатор
  firstName          String // Імʼя користувача
  lastName           String? // Прізвище користувача, необовʼязково
  email              String     @unique // Email, унікальний
  password           String // Хеш пароля
  phone              String?    @unique // Телефон, унікальний, необовʼязково
  bio                String? // Коротка інформація про користувача
  pictures           String? // Посилання на аватар чи фото
  country            String? // Країна користувача
  role               UserRole   @default(USER) // Роль користувача
  linkedIn           String? // Профіль LinkedIn
  instagram          String? // Профіль Instagram
  github             String? // Профіль GitHub
  telegramOrwhatsApp String? // Профіль Telegram або WhatsApp
  isVerified         Boolean    @default(false) @map("is_verified") // Чи пройшов верифікацію
  isTwoFactorEnabled Boolean    @default(false) @map("is_two_factor_enabled") // 2FA
  method             AuthMethod // Метод аутентифікації
  createdAt          DateTime   @default(now()) @map("created_at") // Дата створення
  updatedAt          DateTime   @updatedAt @map("updated_at") // Дата останнього оновлення

  /// Профіль виконавця, якщо користувач – Contractor
  contractorProfile Contractor?

  /// Профіль клієнта, якщо користувач – Client
  clientProfile Client?

  /// Участь у проектах (many-to-many через ProjectMember)
  projectMemberships ProjectMember[]

  /// Проекти, створені клієнтом (EXTERNAL)
  createdProjects Project[] @relation("ClientProjects")

  accounts Account[] // Зовнішні акаунти (Google, GitHub і т.д.)

  @@map("users")
}

/// Таблиця для виконавців (Contractor)
model Contractor {
  userId       String             @id
  role         UserRole
  availability AvailabilityStatus @default(AVAILABLE)
  languages    String[]           @default(["UKRAINIAN"])
  positions    UserPosition[]     @default([UNSELECTED])
  rate         Float?
  skills       Skill[]            @default([])

  user User @relation(fields: [userId], references: [id])

  /// Внутрішні проекти виконавця
  internalProjects Project[] @relation("ContractorProjects")
}

/// Таблиця для клієнтів (Client)
model Client {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])

  @@map("clients")
}

/// Проекти
model Project {
  id          String      @id @default(uuid())
  name        String
  description String?
  images      String[]    @default([])
  type        ProjectType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  /// EXTERNAL проект
  clientId String?
  client   User?   @relation("ClientProjects", fields: [clientId], references: [id])

  /// INTERNAL проект
  ownerId      String?
  owner        Contractor? @relation("ContractorProjects", fields: [ownerId], references: [userId])
  neededPeople Int?
  budget       Float?

  members ProjectMember[]

  @@map("projects")
}

/// Звʼязок юзерів з проектами
model ProjectMember {
  id        String       @id @default(uuid())
  project   Project      @relation(fields: [projectId], references: [id])
  projectId String
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  role      UserPosition // Позиція юзера у проекті

  @@unique([projectId, userId]) // один юзер один раз в проекті
  @@map("project_members")
}

/// Зовнішні акаунти для входу через OAuth
model Account {
  id           String   @id @default(uuid())
  type         String
  provider     String
  refreshToken String?  @map("refresh_token")
  accessToken  String   @map("access_token")
  expiresAt    Int?     @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @map("user_id")

  @@map("accounts")
}

model Token {
  id String @id @default(uuid())

  email     String
  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("tokens")
}

enum TokenType {
  VERIFICATION
  TWO_FACTOR
  PASSWORD_RESET
}

