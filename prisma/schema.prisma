generator client {
  provider = "prisma-client-js"
  output   = "./__generated__"
}

datasource db {
  provider = "postgresql"
  url      = env("PG_URI")
}

model User {
  id                 String             @id @default(uuid())
  firstName          String             @map("first_name")
  lastName           String?            @map("last_name")
  email              String             @unique
  password           String
  bio                String?            @default("") // Short biography or description
  availability       AvailabilityStatus @default(AVAILABLE) @map("availability_status")
  position           UserPosition[]     @default([UNSELECTED]) // Array of positions from the UserPosition enum
  rate               Float? // Hourly rate in USD
  languages          String[]           @default(["Ukraine"]) // Array of languages the user speaks
  skills             Skill[]            @default([]) // Array of skills from the Skill enum
  pictures           String? // Array of image URLs
  role               UserRole           @default(USER)
  isVerified         Boolean            @default(false) @map("is_verified")
  isTwoFactorEnabled Boolean            @default(false) @map("is_two_factor_enabled")
  method             AuthMethod
  accaunts           Accaunt[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("users")
}

model Accaunt {
  id           String   @id @default(uuid())
  type         String
  provider     String
  refreshToken String?  @map("refresh_token")
  accessToken  String   @map("access_token")
  expiresAt    Int?     @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @map("user_id")

  @@map("accaunts")
}

model Token {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  @@map("tokens")
}

enum AuthMethod {
  EMAIL
  GOOGLE
  GITHUB
  LINKEDIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  PART_TIME
}

